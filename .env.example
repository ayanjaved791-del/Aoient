# ─────────────────────────────────────────────────────────────
# Aoient environment variables — NAMES ONLY. Never commit values.
# Copy to `.env` (local dev) and fill in.
# ─────────────────────────────────────────────────────────────

# Account mode: "local" (default — accounts saved in the browser's localStorage,
# no database needed) or "server" (database-backed accounts, organizations, RBAC)
NEXT_PUBLIC_AUTH_MODE=

# Public base URL of the app (used for auth callbacks, email links, origin checks)
APP_URL=

# PostgreSQL connection string, e.g. postgresql://user:pass@localhost:5432/aoient_dev
DATABASE_URL=
# Separate database used by the integration test suite (it is reset by tests)
TEST_DATABASE_URL=

# Better Auth: 32+ byte random secret used to sign session cookies
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as APP_URL in most setups
BETTER_AUTH_URL=

# Email delivery: "console" (dev — prints emails to the server log) or a provider added later
EMAIL_PROVIDER=console
EMAIL_FROM=

# ── Paddle Billing ──
# Public (safe in the browser): client-side token, environment and price IDs.
# With these set, "Buy now" on /pricing opens Paddle's overlay checkout.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_ANNUAL=
# Server-only secrets (never prefix with NEXT_PUBLIC_). Needed to confirm payments
# and activate plans via verified webhooks — requires the database (server mode).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
