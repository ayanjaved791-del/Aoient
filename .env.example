# ─────────────────────────────────────────────────────────────
# Aoient environment variables — NAMES ONLY. Never commit values.
# Copy to `.env` (local dev) and fill in.
# ─────────────────────────────────────────────────────────────

# Public base URL of the app (used for email links and origin checks).
# On Vercel it defaults to the project's production domain if left empty.
APP_URL=

# ── Supabase ──
# Project Settings → API: Project URL and publishable key (the legacy "anon" key also works).
# Vercel's Supabase integration sets NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# and POSTGRES_URL automatically — Aoient accepts those names too.
# Both are public by design; app tables are locked with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "true" only after Google is enabled in Supabase (Authentication → Sign In / Providers → Google).
# Shows "Continue with Google" on sign-in and sign-up. Google's client ID/secret go in Supabase, not here.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
# Cloudflare Turnstile bot check on sign-up, sign-in, password reset and password change.
# Site key only (public). The Turnstile SECRET key goes in Supabase → Authentication → Bot and Abuse Protection.
# Deploy with the site key first, then turn captcha on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Needed with Turnstile on, for sign-ups the server finishes itself when
# Supabase can't send the confirmation email (same secret as in Supabase).
TURNSTILE_SECRET_KEY=
# Supabase → Connect → connection string. On Vercel use the *transaction pooler* URL (port 6543).
# Server-only: never prefix with NEXT_PUBLIC_. Falls back to POSTGRES_URL if empty.
DATABASE_URL=
# Separate PLAIN Postgres database for the integration tests (they wipe it). Not your Supabase project.
TEST_DATABASE_URL=

# Invitation emails: "console" (prints them to the server log) until a provider is added.
# Sign-up verification and password-reset emails are sent by Supabase Auth.
EMAIL_PROVIDER=console
EMAIL_FROM=

# ── Paddle Billing ──
# Public (safe in the browser): client-side token, environment and price IDs.
# With these set, "Buy now" on /pricing opens Paddle's overlay checkout.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MEDISEA_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_MEDISEA_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_INDIANA_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_INDIANA_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_PACFIC_DEEPDIVE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PACFIC_DEEPDIVE_ANNUAL=
# Server-only secrets (never prefix with NEXT_PUBLIC_).
# PADDLE_API_KEY: confirms payments on the success page and opens the billing portal.
# PADDLE_WEBHOOK_SECRET: Paddle → Developer tools → Notifications → your destination's
# secret key. Verifies webhooks (the only way a paid plan is activated) and signs checkouts.
# Webhook URL to register in Paddle: <APP_URL>/api/webhooks/paddle (events: subscription.*)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Server only, never NEXT_PUBLIC_. Lets admins create staff logins (People → Create login),
# and lets people sign up when Supabase can't send the confirmation email.
# Vercel's Supabase integration adds it automatically.
SUPABASE_SERVICE_ROLE_KEY=

# ── Desktop app downloads (optional) ──
# GitHub "owner/repo" whose Releases hold the desktop installers built by
# .github/workflows/desktop.yml. Leave empty to use this project's own repository.
DESKTOP_RELEASES_REPO=
