# ─────────────────────────────────────────────────────────────
# Aoient environment variables — NAMES ONLY. Never commit values.
# Copy to `.env` (local dev) and fill in.
# ─────────────────────────────────────────────────────────────

# Public base URL of the app (used for auth callbacks, email links, origin checks)
APP_URL=

# PostgreSQL connection string, e.g. postgresql://user:pass@localhost:5432/aoient_dev
DATABASE_URL=
# Separate database used by the integration test suite (it is reset by tests)
TEST_DATABASE_URL=

# Better Auth: 32+ byte random secret used to sign session cookies
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as APP_URL in most setups
BETTER_AUTH_URL=

# Email delivery: "console" (dev — prints emails to the server log) or a provider added later
EMAIL_PROVIDER=console
EMAIL_FROM=

# ── Paddle Billing (Milestone M8 — not yet wired) ──
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_ANNUAL=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_ANNUAL=

# ── File storage (Milestone M5 — not yet wired) ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
